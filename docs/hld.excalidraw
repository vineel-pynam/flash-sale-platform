  {
   "id": "e80",
   "type": "text",
   "x": 1560,
   "y": 60,
   "width": 430,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1048118163,
   "version": 1,
   "versionNonce": 1000704748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key numbers\n- 500K req/s at peak, ~15K/s reach us\n- edge (CDN + waiting room) answers 97%\n- let in ~1,100 people/s\n- PSP limit 1,000 payments/s\n- 50,000 units, 10M people waiting",
   "originalText": "Key numbers\n- 500K req/s at peak, ~15K/s reach us\n- edge (CDN + waiting room) answers 97%\n- let in ~1,100 people/s\n- PSP limit 1,000 payments/s\n- 50,000 units, 10M people waiting",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "e81",
   "type": "text",
   "x": 40,
   "y": 1440,
   "width": 700,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1031640629,
   "version": 1,
   "versionNonce": 1039027014,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Never fail: no double sell, no double charge,\nno charge without an order.\n\nCan slow down: \"how many left\" may be 1–2 s old, queue order,\nhow fast the confirmation arrives.",
   "originalText": "Never fail: no double sell, no double charge,\nno charge without an order.\n\nCan slow down: \"how many left\" may be 1–2 s old, queue order,\nhow fast the confirmation arrives.",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "e82",
   "type": "text",
   "x": 800,
   "y": 1440,
   "width": 760,
   "height": 135,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 669697760,
   "version": 1,
   "versionNonce": 184435920,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Dashed arrows = background or outside flows.\nRed dashed outlines = failure boundaries.\nHold never waits on Postgres or the PSP.\nPostgres rules reject any mistake Redis makes (no double sell).\nOne availability zone fails: nothing lost, back in < 1 min.\nHome region fails: the drop pauses, standby takes over in < 15 min.",
   "originalText": "Dashed arrows = background or outside flows.\nRed dashed outlines = failure boundaries.\nHold never waits on Postgres or the PSP.\nPostgres rules reject any mistake Redis makes (no double sell).\nOne availability zone fails: nothing lost, back in < 1 min.\nHome region fails: the drop pauses, standby takes over in < 15 min.",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
