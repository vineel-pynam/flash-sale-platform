# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Postgres (docker compose) ---
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=change-me-local-only

# --- reservation-service ---
HTTP_ADDR=:8080
REDIS_ADDR=127.0.0.1:6379
REDIS_POOL_SIZE=64
DATABASE_URL=postgres://flashsale:change-me-local-only@127.0.0.1:5432/flashsale?sslmode=disable
# Per-pod pool. Sum over (HPA max replicas x pool size) must stay <= 80% of max_connections.
DB_MAX_CONNS=10
# Separate pool for the payment worker and fix-up job, so a flood of Pay requests cannot starve them.
DB_WORKER_CONNS=6

# HMAC key used to verify waiting-room admission tokens. Generate your own for local use, e.g.
#   openssl rand -hex 32
ADMISSION_TOKEN_KEY=replace-with-random-hex

# Drop configuration
DROP_ID=drop-1
DROP_UNITS=50000
DROP_BUCKETS=50
HOLD_TTL=3m
PRICE_CENTS=9900

# Load shedding: max concurrent requests per pod (reserve / checkout)
MAX_INFLIGHT_RESERVE=1000
MAX_INFLIGHT_CHECKOUT=200

# Fake PSP used by the prototype (no real payment provider is called)
PSP_RATE_LIMIT=1000
PSP_LATENCY=50ms
PSP_TIMEOUT_AFTER_CHARGE_RATE=0.01
PSP_DECLINE_RATE=0.05
